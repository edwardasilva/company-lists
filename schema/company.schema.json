{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edwardasilva/company-lists/schema/company.schema.json",
  "title": "Company row",
  "description": "One row of a data/<country>/<state>/<region>.csv file. Every CSV cell is a string, and an empty cell is an empty string. The column order of the CSV header is the order of x-columns.",
  "type": "object",
  "x-columns": [
    "id",
    "name",
    "website",
    "careers_url",
    "industry",
    "field",
    "city",
    "state",
    "region",
    "country",
    "hq",
    "size_band",
    "ee_relevant",
    "source_url",
    "last_verified",
    "notes"
  ],
  "required": [
    "id",
    "name",
    "website",
    "careers_url",
    "industry",
    "field",
    "city",
    "state",
    "region",
    "country",
    "hq",
    "size_band",
    "ee_relevant",
    "source_url",
    "last_verified",
    "notes"
  ],
  "x-nonempty": [
    "id",
    "name",
    "website",
    "industry",
    "city",
    "state",
    "region",
    "country",
    "hq",
    "source_url",
    "last_verified"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Stable slug, unique across the whole repo. Never reuse or rename one."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Company name as the company writes it."
    },
    "website": {
      "type": "string",
      "pattern": "^https://[^\\s/@]+\\.[^\\s/@]+/$",
      "description": "Company home page, https, ending in a slash, no path."
    },
    "careers_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^(https://[^\\s/@]+\\.[^\\s/@]+(/[^\\s]*)?)?$",
      "description": "Optional. The company's own careers or jobs page, https, not a job board."
    },
    "industry": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "An industry value from schema/industries.csv."
    },
    "field": {
      "type": "string",
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$",
      "description": "Optional. A field listed for that industry in schema/industries.csv."
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "City of this location, as the source gives it."
    },
    "state": {
      "type": "string",
      "enum": [
        "AL",
        "AK",
        "AZ",
        "AR",
        "CA",
        "CO",
        "CT",
        "DE",
        "DC",
        "FL",
        "GA",
        "HI",
        "ID",
        "IL",
        "IN",
        "IA",
        "KS",
        "KY",
        "LA",
        "ME",
        "MD",
        "MA",
        "MI",
        "MN",
        "MS",
        "MO",
        "MT",
        "NE",
        "NV",
        "NH",
        "NJ",
        "NM",
        "NY",
        "NC",
        "ND",
        "OH",
        "OK",
        "OR",
        "PA",
        "RI",
        "SC",
        "SD",
        "TN",
        "TX",
        "UT",
        "VT",
        "VA",
        "WA",
        "WV",
        "WI",
        "WY",
        "AS",
        "GU",
        "MP",
        "PR",
        "VI"
      ],
      "description": "USPS state code."
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Metro region. Its slug is the file name, such as Denver for denver.csv."
    },
    "country": {
      "type": "string",
      "enum": [
        "US"
      ],
      "description": "ISO 3166-1 alpha-2 code."
    },
    "hq": {
      "type": "string",
      "enum": [
        "true",
        "false"
      ],
      "description": "true when this location is the company's headquarters."
    },
    "size_band": {
      "type": "string",
      "enum": [
        "",
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "501-1000",
        "1001-5000",
        "5001-10000",
        "10001+"
      ],
      "description": "Optional. Employee count band from a cited source."
    },
    "ee_relevant": {
      "type": "string",
      "enum": [
        "",
        "true",
        "false"
      ],
      "description": "Optional. true when the company hires electrical or computer engineers."
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://[^\\s/@]+\\.[^\\s/@]+(/[^\\s]*)?$",
      "description": "Public page that backs the row, usually the company's own site."
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date someone last checked the row against source_url, YYYY-MM-DD."
    },
    "notes": {
      "type": "string",
      "maxLength": 200,
      "description": "Optional. Short and neutral. No personal names or contact details."
    }
  }
}
